{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "assets/*": ["./src/assets/*"],
      "images/*": ["./src/assets/images/*"],
      "components/*": ["./src/components/*"],
      "constants/*": ["./src/constants/*"],
      "services/*": ["./src/services/*"],
      "utils/*": ["./src/utils/*"],
      "@utils/*": ["./src/utils/*"],
      "src/*": ["./src/*"]
    },
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"]
}
