---
import 'assets/css/main.scss';
import '@fortawesome/fontawesome-svg-core/styles.css';
import 'nprogress/nprogress.css';
import { ClientRouter } from 'astro:transitions';
import { siteMetadata } from '../lib/site-metadata';
import { organizationJsonLd, websiteJsonLd, breadcrumbJsonLd } from '../lib/jsonld';

import TopMenu from '../components/Menu/Header/TopMenu.astro';
import FormCTASection from '../components/Footer/CTA/FormCTASection.jsx';
import Footer from '../components/Footer/Footer.astro';
import { getMegaMenuBlogPosts, getBlogCategories } from '../lib/blog-data';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  path?: string;
  bodyClass?: string;
  hideFormCTA?: boolean;
  forCaseStudy?: boolean;
}

const {
  title = siteMetadata.title,
  description = siteMetadata.description,
  keywords = siteMetadata.keywords,
  image,
  path = '',
  bodyClass = '',
  hideFormCTA = false,
  forCaseStudy = false,
} = Astro.props;

const pageUrl = new URL(path ?? '', Astro.site ?? siteMetadata.siteUrl).toString();
const themeColor = '#ff5757';

const orgSchema = organizationJsonLd();
const siteSchema = websiteJsonLd();
const breadcrumbSchema = breadcrumbJsonLd(path ?? '');

// Mega-menu data: every page builds the same blog-category dropdown, so fetch
// once at SSR time and feed it into the TopMenu island as props.
const [megaBlogs, megaCategories] = await Promise.all([
  getMegaMenuBlogPosts(),
  getBlogCategories(),
]);
---

<!doctype html>
<html lang="en" data-theme={siteMetadata.defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:site_name" content="Truemark" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    )}

    <ClientRouter />

    <script is:inline>
      // Theme attribute must apply on every navigation, not just initial load,
      // because ClientRouter swaps the <html data-theme> attribute between pages.
      // Listen for astro:after-swap so the persisted theme survives transitions.
      function applyTheme() {
        try {
          const theme = window.localStorage.getItem('theme') || 'light';
          document.documentElement.setAttribute('data-theme', theme);
          if (document.body) document.body.setAttribute('data-theme', theme);
        } catch (_) {}
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <style is:global>
      #nprogress .bar { background: #ff5757; height: 3px; }
      #nprogress .peg { box-shadow: 0 0 10px #ff5757, 0 0 5px #ff5757; }
      #nprogress .spinner { display: none; }
    </style>
  </head>
  <body class={bodyClass} data-theme={siteMetadata.defaultTheme}>
    <TopMenu
      blogPosts={megaBlogs}
      blogCategories={megaCategories}
      transition:persist
      transition:name="site-header"
    />
    <main transition:animate="fade">
      <slot />
    </main>
    {!hideFormCTA && (
      <FormCTASection client:only="react" transition:persist transition:name="form-cta" />
    )}
    <Footer
      forCaseStudy={forCaseStudy}
      transition:persist
      transition:name="site-footer"
    />
    <script>
      // Top-of-page progress bar. With ClientRouter active we drive NProgress
      // off Astro's transition events instead of beforeunload/pageshow, which
      // do not fire during a SPA swap.
      import NProgress from 'nprogress';
      NProgress.configure({ showSpinner: false, trickleSpeed: 120 });

      document.addEventListener('astro:before-preparation', () => NProgress.start());
      document.addEventListener('astro:after-swap', () => NProgress.done());
      // Hard-navigation fallbacks (covers external links and reloads).
      window.addEventListener('beforeunload', () => NProgress.start());
      window.addEventListener('pageshow', () => NProgress.done());
      NProgress.done();
    </script>
  </body>
</html>
