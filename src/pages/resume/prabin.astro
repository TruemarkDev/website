---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FetchedDataTemplete from '../../components/CV/FetchedDataTemplete';
import { profile } from '../../data/resume/prabin';
import { getAllBlogsForSection } from '../../lib/blog-data';
import metaImage from 'images/meta-images/resume/prabin.webp?url';

const blogs = await getAllBlogsForSection();
---

<BaseLayout
  title="Prabin Poudel | Senior Ruby Developer From Kathmandu"
  description="Truemark | Software Development Team | Nepal | Remote"
  keywords="About Truemark, Truemark Technology, Remote Software Development Team"
  image={metaImage}
  path="resume/prabin"
>
  <FetchedDataTemplete profile={profile} blogs={blogs} client:only="react" />
</BaseLayout>
