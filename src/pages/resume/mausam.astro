---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CVTemplate from '../../components/CV/Template';
import { profile } from '../../data/resume/mausam';
import { getAllBlogsForSection } from '../../lib/blog-data';

const blogs = await getAllBlogsForSection();
---

<BaseLayout
  title="Mausam Khanal | Senior Frontend Developer From Kathmandu"
  description="Truemark | Software Development Team | Nepal | Remote"
  keywords="About Truemark, Truemark Technology, Remote Software Development Team"
  path="resume/mausam"
>
  <CVTemplate profile={profile} blogs={blogs} client:only="react" />
</BaseLayout>
