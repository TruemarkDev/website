---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBody from '../../components/PagesReact/hire/resources.jsx';
import { getFeaturedBlogs, getBlogsByTag } from '../../lib/blog-data';

const featuredBlogs = await getFeaturedBlogs(3);
const teamBuildingBlogs = await getBlogsByTag('build-team', 3);
---

<BaseLayout
  title="Truemark | Hire Resources"
  description="Hire dedicated resources from Truemark."
  path="hire/resources"
>
  <PageBody data={{ featuredBlogs, teamBuildingBlogs }} client:only="react" />
</BaseLayout>
