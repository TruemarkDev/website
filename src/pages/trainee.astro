---
import BaseLayout from '../layouts/BaseLayout.astro';
import CurrentOpenings from '../components/Career/CurrentOpenings.jsx';
import TraineeHeroSection from '../components/HeroSection/TraineeHeroSection.jsx';
import HowToApply from '../components/Trainee/HowToApply.jsx';
import OurProgram from '../components/Trainee/OurProgram.jsx';
import StepUp from '../components/Trainee/StepUp.astro';
import TraineeFAQ from '../components/Trainee/TraineeFAQ.jsx';
import TraineeTestimonialSection from '../components/Trainee/TraineeTestimonialSection.jsx';
import TruemarkOpportunities from '../components/Trainee/TruemarkOpportunities.jsx';
import traineeTestimonial from '../constants/testimonials/trainee';
import { getCollection } from 'astro:content';
import { resolveUrl } from '../lib/image-resolver';

const jobs = await getCollection('jobs', ({ data }) => data.positionOpen);
jobs.sort((a, b) => {
  const dateDiff = new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  if (dateDiff !== 0) return dateDiff;
  return (a.data.vacancyCount ?? 0) - (b.data.vacancyCount ?? 0);
});
const openings = await Promise.all(
  jobs.map(async (j) => ({
    node: {
      fields: { slug: `/jobs/${j.data.customSlug}` },
      frontmatter: {
        ...j.data,
        slug: j.data.customSlug,
        featuredImage: await resolveUrl(j.data.featuredImage as string | undefined),
      },
    },
  })),
);
---

<BaseLayout
  title="Truemark | Trainee"
  description="Truemark | Top gatsbyjs developers in Nepal"
  keywords="gatsbyjs development, gatsby, truemark"
  path="trainee"
>
  <TraineeHeroSection client:visible />
  <StepUp />
  <TruemarkOpportunities client:visible />
  <OurProgram client:visible />
  <TraineeTestimonialSection
    items={traineeTestimonial}
    sectionTitle="Don't take our word for it. trust our trainee"
    sectionSubheading="Our Trainee Feedback"
    client:visible
  />
  <HowToApply client:visible />
  <CurrentOpenings openings={openings} client:visible />
  <TraineeFAQ client:visible />
</BaseLayout>
