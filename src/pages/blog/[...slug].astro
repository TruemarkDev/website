---
import { getCollection, getEntry, render } from 'astro:content';
import readingTime from 'reading-time';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveUrl } from '../../lib/image-resolver';
import BlogPostHeader from '../../components/BlogPost/BlogPostHeader.astro';
import BlogToc from '../../components/BlogPost/BlogToc.astro';
import RelatedPosts from '../../components/BlogPost/RelatedPosts.astro';
import AuthorCTA from '../../components/BlogPost/AuthorCTA.astro';
import SidebarCTA from '../../components/BlogPost/SidebarCTA.astro';
import SubscribeBanner from '../../components/BlogPost/SubscribeBanner.astro';

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => data.type === 'blog-post');
  return all.map((entry) => ({
    params: { slug: entry.data.customSlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data as Record<string, any>;

// Resolve author from authors collection (file id == author name lowercased).
const authorId = (data.author ?? '').toLowerCase().trim();
let author: {
  name?: string;
  position?: string;
  bio?: string;
  avatar?: string;
  resume?: string;
} | null = null;
if (authorId) {
  try {
    const a = await getEntry('authors', authorId);
    if (a) {
      author = {
        name: a.data.name,
        position: a.data.position,
        bio: a.data.bio,
        avatar: a.data.avatar as string | undefined,
        resume: a.data.resume,
      };
    }
  } catch (_) {}
}

// Render MDX content + extract headings for the TOC.
const { Content, headings } = await render(entry);

// Related posts: same category, exclude current, newest first, max 3.
const allPosts = await getCollection('blog', ({ data }) => data.type === 'blog-post');
const relatedPosts = allPosts
  .filter(
    (p) =>
      p.data.customSlug !== data.customSlug &&
      p.data.category &&
      p.data.category === data.category
  )
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  )
  .slice(0, 3);
const relatedPostsResolved = await Promise.all(
  relatedPosts.map(async (p) => ({
    slug: p.data.customSlug,
    title: p.data.title,
    hero: await resolveUrl(p.data.featuredImage as string | undefined),
    category: p.data.category,
  })),
);

const minutes = data.readingTime
  ? { text: data.readingTime }
  : readingTime(entry.body || '');
const hero = await resolveUrl(data.featuredImage as string | undefined);
const authorAvatar = await resolveUrl(author?.avatar);
if (author) author.avatar = authorAvatar;
const lastModified =
  data.last_modified_at instanceof Date
    ? data.last_modified_at.toISOString().slice(0, 10)
    : data.last_modified_at ?? data.date;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description ?? '',
  datePublished: new Date(data.date).toISOString(),
  dateModified: lastModified ? new Date(lastModified).toISOString() : undefined,
  author: author ? { '@type': 'Person', name: author.name } : undefined,
  publisher: {
    '@type': 'Organization',
    name: 'Truemark Technology',
  },
  image: hero,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`blog/${data.customSlug}`, Astro.site).toString(),
  },
};

const disqusShortname =
  import.meta.env.PUBLIC_DISQUS_SHORTNAME ?? 'truemark-com-np';
---

<BaseLayout
  title={data.title}
  description={data.description}
  keywords={data.keywords}
  image={hero ?? undefined}
  path={`blog/${data.customSlug}`}
>
  <BlogPostHeader
    title={data.title}
    date={lastModified}
    author={author}
    category={data.category}
    readingTimeText={minutes.text}
    slug={data.customSlug}
    tags={data.tags}
  />

  {data.toc !== false && <BlogToc headings={headings} />}

  <div class="container mt-5 mb-5">
    <div class="row">
      <div class="col-lg-8 col-md-12">
        <article class="blog-content">
          <Content />
        </article>

        {author && (
          <AuthorCTA
            name={author.name ?? ''}
            position={author.position}
            bio={author.bio}
            avatar={author.avatar}
          />
        )}

        <SubscribeBanner />
      </div>

      <aside class="col-lg-4 col-md-12 ps-lg-5 ps-sm-0 position-relative">
        <RelatedPosts posts={relatedPostsResolved} />
        <SidebarCTA />
      </aside>
    </div>
  </div>

  {disqusShortname && data.comments !== false && (
    <div class="container mt-5 mb-5">
      <div class="row">
        <div class="col-lg-12">
          <div id="disqus_thread"></div>
          <script is:inline define:vars={{ disqusShortname, slug: data.customSlug, uid: data.uid, title: data.title }}>
            (function () {
              const d = document, s = d.createElement('script');
              s.src = `https://${disqusShortname}.disqus.com/embed.js`;
              s.setAttribute('data-timestamp', String(+new Date()));
              window.disqus_config = function () {
                this.page.identifier = uid || slug;
                this.page.title = title;
              };
              (d.head || d.body).appendChild(s);
            })();
          </script>
        </div>
      </div>
    </div>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
</BaseLayout>
