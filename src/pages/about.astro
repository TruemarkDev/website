---
import BaseLayout from '../layouts/BaseLayout.astro';
import SingleCaseStudySection from '../components/CaseStudy/Section/SingleCaseStudySection.jsx';
import OurMissionSection from '../components/Company/Section/OurMissionSection.jsx';
import OurVisionSection from '../components/Company/Section/OurVisionSection.jsx';
import ProcessSection from '../components/Company/Section/ProcessSection.jsx';
import AboutHeroSection from '../components/HeroSection/AboutHeroSection.jsx';
import AboutHeroStatsSection from '../components/HeroSection/AboutHeroStatsSection.jsx';
---

<BaseLayout
  title="Truemark | About Us"
  description="Truemark | Software Development Team | Nepal | Remote"
  keywords="About Truemark, Truemark Technology, Remote Software Development Team"
  path="about"
>
  <AboutHeroSection client:visible />
  <AboutHeroStatsSection client:visible />
  <OurVisionSection client:visible />
  <OurMissionSection client:visible />
  <ProcessSection client:visible />
  <SingleCaseStudySection client:visible />
</BaseLayout>
