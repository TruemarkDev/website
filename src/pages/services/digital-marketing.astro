---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DMTeamSection from '../../components/Team/Section/DMTeamSection';
import TestimonialSection from '../../components/Testimonial/Section/TestimonialSection';
import CompanyStatsSection from '../../components/Stats/Section/CompanyStatsSection';
import DMHeroSection from '../../components/HeroSection/DMHeroSection';
import DmServiceSection from '../../components/Service/Section/DmServiceSection';
import DMBannerSection from '../../components/Banner/DMBannerSection';
import BlogSection from '../../components/Blog/BlogSection.astro';
import digitalMarketingTestimonials from '../../constants/testimonials/digitalMarketing';
import { getBlogsByTag } from '../../lib/blog-data';

const dmBlogs = await getBlogsByTag('digital marketing', 3);
---

<BaseLayout
  title="Truemark | Digital Marketing"
  description="Digital Marketing services from Truemark"
  keywords="digital marketing, seo, truemark"
  path="services/digital-marketing"
>
  <DMHeroSection client:only="react" />
  <CompanyStatsSection employeeCount={5} client:only="react" />
  <DmServiceSection client:only="react" />
  <DMBannerSection client:only="react" />
  <TestimonialSection items={digitalMarketingTestimonials} client:only="react" />
  <BlogSection
    blogs={dmBlogs}
    heading="Latest from the blog"
    headerTag="Seo Blog"
    buttonText="View All Blogs"
    blogRedirectRoute="/blog"
  />
  <DMTeamSection client:only="react" />
</BaseLayout>
