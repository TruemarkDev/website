---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioNav from '../components/Menu/Portfolio/PortfolioNav.jsx';
import PortfolioList from '../components/Portfolio/PortfolioList.jsx';
import { getCollection } from 'astro:content';
import { resolveUrl } from '../lib/image-resolver';

const projectEntries = await getCollection('projects');

const projects = await Promise.all(
  projectEntries
    .filter((p) => {
      const list = (p.data as any).featuredIn;
      return Array.isArray(list) ? list.includes('portfolio-index') : true;
    })
    .sort((a, b) =>
      String(a.data.uid ?? '').localeCompare(String(b.data.uid ?? ''))
    )
    .map(async (p) => ({
      node: {
        id: p.id,
        excerpt: '',
        frontmatter: {
          ...p.data,
          bgImage: await resolveUrl(p.data.bgImage),
          featuredImage: await resolveUrl(p.data.featuredImage),
          ownerImage: await resolveUrl(p.data.ownerImage),
          companyLogo: await resolveUrl(p.data.companyLogo),
        },
      },
    }))
);
---

<BaseLayout
  title="Truemark | Portfolio"
  description="Some of the tech solutions we shipped to our clients from all over the globe."
  keywords="About Truemark, Truemark Technology, Remote Software Development Team"
  path="portfolio"
>
  <PortfolioNav client:visible />
  <PortfolioList projects={projects} client:visible />
</BaseLayout>
