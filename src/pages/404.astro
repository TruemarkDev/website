---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import bannerImage from '../assets/images/layout/404_page.svg';
---

<BaseLayout title="Truemark | Page not found" path="404">
  <section class="position-relative overflow-hidden hero-section mt-5">
    <div class="container">
      <div class="row flip-content-sm">
        <div class="col-lg-8 col-md-6 col-sm-12 mx-auto d-flex flex-column align-items-center justify-content-between">
          <Image
            src={bannerImage}
            alt="page not found"
            class="img-fluid w-50"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="text-center mt-4">
            <h1>ERROR: 404</h1>
            <p class="text-secondary">
              You just hit a route that doesn't exist... the sadness.
            </p>
            <a href="/" class="text-primary">← Go back home</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
