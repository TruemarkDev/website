---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerFAQ from '../components/Career/CareerFAQ.jsx';
import CurrentOpenings from '../components/Career/CurrentOpenings.jsx';
import HandBook from '../components/Career/HandBook.jsx';
import OurTraineeProgramSection from '../components/Career/OurTraineeProgramSection.jsx';
import ValueSection from '../components/Company/Section/ValueSection.jsx';
import CareerHeroSection from '../components/HeroSection/CareerHeroSection.jsx';
import HowToApply from '../components/Trainee/HowToApply.jsx';
import { getCollection } from 'astro:content';
import { getTraineeProgramEdges } from '../lib/career-data';
import { resolveImage } from '../lib/image-resolver';

const jobs = await getCollection('jobs', ({ data }) => data.positionOpen);
jobs.sort((a, b) => {
  const dateDiff = new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  if (dateDiff !== 0) return dateDiff;
  return (a.data.vacancyCount ?? 0) - (b.data.vacancyCount ?? 0);
});
const openings = await Promise.all(
  jobs.map(async (j) => {
    const featuredImage = (await resolveImage(j.data.featuredImage as string | undefined))?.src
      ?? (j.data.featuredImage as string | undefined);
    return {
      node: {
        fields: { slug: `/jobs/${j.data.customSlug}` },
        frontmatter: { ...j.data, slug: j.data.customSlug, featuredImage },
      },
    };
  }),
);
const traineePrograms = await getTraineeProgramEdges();
---

<BaseLayout
  title="Truemark | Current Openings | Apply Now | Remote Job"
  description="Truemark | We are looking for talented and motivated people to attain our goal together"
  keywords="Jobs in Kathmandu, Ruby, Rails, React Native, truemark"
  path="careers"
>
  <CareerHeroSection client:visible />
  <ValueSection client:visible />
  <HandBook client:visible />
  <CurrentOpenings openings={openings} client:visible />
  <OurTraineeProgramSection programs={traineePrograms} client:visible />
  <HowToApply client:visible />
  <CareerFAQ client:visible />
</BaseLayout>
