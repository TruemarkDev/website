---
import { faCheck } from '@fortawesome/free-solid-svg-icons';
import HandBookImg from 'images/career/handbook.png?url';

const [w, h, , , pathData] = faCheck.icon;
const checkPath = Array.isArray(pathData) ? pathData.join('') : pathData;
---

<section class="">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7 col-md-7 col-sm-12 mb-4 mb-md-0">
        <h1 class="h1 mb-4">Want to know our culture and how we work</h1>
        <p class="mb-4">Our Handbook provides an overview of why we exist, our roles, our investment into staff welfare, our team norms, Software Development Life Cycle (SDLC) guides, and details of our processes, policies and benefits. It's filled with things we've learned based on our own experience and study of others' experiences.</p>
        <ul class="list-unstyled ms-0">
          {['About Company', 'Benefits', 'Guidelines'].map((label) => (
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${w} ${h}`} width="1em" height="1em" fill="currentColor" class="me-3" aria-hidden="true">
                <path d={checkPath} />
              </svg>
              {label}
            </li>
          ))}
        </ul>
        <a href="https://handbook.truemark.dev/docs/handbook/" target="_blank" class="btn btn-lg btn-primary outlined mt-4">
          Check our handbook
        </a>
      </div>
      <div class="col-lg-5 col-md-5 col-sm-12">
        <img class="img-fluid mt-sm-4" src={HandBookImg} alt="Truemark Handbook" />
      </div>
    </div>
  </div>
</section>
