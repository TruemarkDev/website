---
import ApplyImage from 'images/trainee/Apply.png?url';
import VideoInterviewImage from 'images/trainee/Video-Interview.png?url';
import WelcomeImage from 'images/trainee/Welcome.png?url';
import TaskImage from 'images/trainee/Task.png?url';
---

<section class="how-to-apply position-relative overflow-hidden">
      <div class="container">
        <div class="header text-center mb-5 pb-2">
          <div class="header-tag text-uppercase">KNOW ABOUT</div>
          <h2 class="mb-4">How to Apply</h2>
        </div>
        <div class="row justify-content-between justify-content-md-end">
          <div class="col-sm-6 col-md-4 col-lg-3 col-xl-3 mb-3 pb-3">
            <div class="rounded process process-apply h-100 p-4 position-relative">
              <div class="d-flex flex-wrap align-items-center align-items-sm-start align-items-xxl-center flex-row flex-sm-column flex-xxl-row mb-4">
                <span class="icon rounded-circle me-2 p-1 d-flex">
                  <img
                    class="img-fluid m-auto"
                    src={ApplyImage}
                    alt="apply"
                  />
                </span>
                <h4 class="m-0 mt-0 mt-sm-3 mt-xxl-0">Apply</h4>
              </div>
              <p>Submit your CV and complete an online application form.</p>
            </div>
          </div>
          <div class="col-sm-6 col-md-4 col-lg-3 col-xl-3 mb-3 pb-3">
            <div class="rounded process process-video-interview h-100 p-4 position-relative">
              <div class="d-flex flex-wrap align-items-center align-items-sm-start align-items-xxl-center flex-row flex-sm-column flex-xxl-row mb-4">
                <span class="icon rounded-circle me-2 p-1 d-flex">
                  <img
                    class="img-fluid m-auto"
                    src={VideoInterviewImage}
                    alt="video interview"
                  />
                </span>
                <h4 class="m-0 mt-0 mt-sm-3 mt-xxl-0">Video Interview</h4>
              </div>
              <p>
                Video interview with the hiring managers and other members of
                the team.
              </p>
            </div>
          </div>
          <div class="col-sm-6 col-md-4 col-lg-3 col-xl-3 mb-3 pb-3">
            <div class="rounded process process-task h-100 p-4 position-relative">
              <div class="d-flex flex-wrap align-items-center align-items-sm-start align-items-xxl-center flex-row flex-sm-column flex-xxl-row mb-4">
                <span class="icon rounded-circle me-2 p-1 d-flex">
                  <img
                    class="img-fluid m-auto"
                    src={TaskImage}
                    alt="complete a task"
                  />
                </span>
                <h4 class="m-0 mt-0 mt-sm-3 mt-xxl-0">Complete a task</h4>
              </div>
              <p>Assign a task to see your knowledge and skills.</p>
            </div>
          </div>
          <div class="col-sm-6 col-md-4 col-lg-3 col-xl-3 mb-3 pb-3">
            <div class="rounded process process-welcome h-100 p-4 position-relative">
              <div class="d-flex flex-wrap align-items-center align-items-sm-start align-items-xxl-center flex-row flex-sm-column flex-xxl-row mb-4">
                <span class="icon rounded-circle me-2 p-1 d-flex">
                  <img
                    class="img-fluid m-auto"
                    src={WelcomeImage}
                    alt="welcome"
                  />
                </span>
                <h4 class="m-0 mt-0 mt-sm-3 mt-xxl-0">Welcome</h4>
              </div>
              <p>Congratulations! Welcome to Truemark. </p>
            </div>
          </div>
        </div>
      </div>
    </section>
