---
import { faUsers, faProjectDiagram, faSmileBeam, faClock } from '@fortawesome/free-solid-svg-icons';

const { employeeCount } = Astro.props;

const fa = (icon: typeof faUsers) => {
  const [w, h, , , d] = icon.icon;
  return { w, h, d: Array.isArray(d) ? d.join('') : d };
};
const stats = [
  { icon: fa(faUsers), value: `${employeeCount}+`, label: 'Experts' },
  { icon: fa(faClock), value: '2017', label: 'Serving Since' },
  { icon: fa(faProjectDiagram), value: '25+', label: 'Projects' },
  { icon: fa(faSmileBeam), value: '25+', label: 'Happy Clients' },
];
---

<aside class="stat-only mt-5">
  <div class="container">
    <div class="row ">
      <div class="col-lg-12 w-100">
        <div class="banner-cta d-flex align-items-center flex-column flex-lg-row justify-content-lg-around  team-cta text-center py-5 px-0 px-md-4 shadow-lg">
          <div class="col-md-12 stat-box d-flex flex-row flex-wrap py-3">
            {stats.map(({ icon, value, label }) => (
              <div class="stat d-flex align-items-center m-2">
                <div class="icon-holder">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${icon.w} ${icon.h}`} width="1em" height="1em" fill="currentColor" class="stroke-icon" aria-hidden="true">
                    <path d={icon.d} />
                  </svg>
                </div>
                <div class="text-holder">
                  <h2 class="m-0">{value}</h2>
                  <small class="text-secondary">{label}</small>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</aside>
