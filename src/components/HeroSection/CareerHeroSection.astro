---
import { faArrowRight } from '@fortawesome/free-solid-svg-icons';
import HeroSectionImage from 'images/company/Career-page-hero-section-image.png?url';

const [aw, ah, , , aPath] = faArrowRight.icon;
const arrowPath = Array.isArray(aPath) ? aPath.join('') : aPath;
---

<section class="bg-hero1 position-relative overflow-hidden pt-5 pb-0">
  <div class="position-relative container">
    <div class="row align-items-center">
      <div class="col-lg-6 col-md-10 col-sm-12 rm-content-container">
        <div class="header-tag mb-2">You want to</div>
        <h1 class="mb-4 text-secondary">
          Be a part of a world class team
        </h1>
        <p class="text-secondary">
          We are agile, smart and result driven. We love getting things done
          and do it better everytime.
        </p>
        <p class="text-secondary mb-5">
          <strong>We believe our people are our greatest asset</strong> and
          we're always looking for bright new people and personalities to
          join our company.
        </p>
        <a href="#openpositions" class="btn btn-lg btn-primary">
          See Open Positions
          <svg xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${aw} ${ah}`} width="1em" height="1em" fill="currentColor" class="ms-3" aria-hidden="true">
            <path d={arrowPath} />
          </svg>
        </a>
      </div>
      <div class="col-lg-6 position-relative mb-sm-0 mb-md-0 d-flex justify-content-end">
        <img src={HeroSectionImage} alt="hero image" class="img-fluid" />
      </div>
      <div class="pink position-absolute"></div>
      <div class="blue position-absolute"></div>
    </div>
  </div>
</section>
