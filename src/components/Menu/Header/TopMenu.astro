  <!-- Mobile nav (hidden on desktop via CSS) -->
  <nav id="mobile-nav" class="navbar navbar-expand-lg navbar-light mobile-nav">
    <div class="container mobile-navbar d-flex justify-content-between align-items-center">
      <button
        id="mobile-toggler"
        class="navbar-toggler mb-1"
        type="button"
        aria-controls="mobileNavContent"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="toggler-icon">
          <svg viewBox="0 0 100 65" width="30" height="30">
            <rect y="0" width="100" height="5" />
            <rect y="30" width="100" height="5" />
            <rect y="60" width="100" height="5" />
          </svg>
        </span>
      </button>
      <a class="navbar-brand p-0 m-0" href="/">
        <img
          id="mobile-logo"
          src="/images/company-logo/logo_red.svg"
          class="img-fluid mb-0 company-logo"
          alt="Truemark logo"
          width="150"
        />
      </a>
    </div>

    <div id="mobileNavContent" class="collapse navbar-collapse">
      <div class="nav-content d-flex justify-content-between align-items-center mt-4">
        <ul class="navbar-nav nav-links ms-3">
          <li class="nav-item"><a href="/" class="nav-link">Home</a></li>
          <li class="nav-item"><a href="/about/" class="nav-link">About Us</a></li>
          <li class="nav-item"><a href="/blog/" class="nav-link">Blog</a></li>
          <li class="nav-item"><a href="/portfolio/" class="nav-link">Portfolio</a></li>
          <li class="nav-item"><a href="/careers/" class="nav-link">Careers</a></li>
          <li class="nav-item"><a href="/contact/" class="nav-link">Contact Us</a></li>

          <li class="nav-item dropdown sub-menu-parent">
            <a
              id="mobile-services-toggle"
              href="#"
              class="nav-link sub-menu d-flex align-items-center"
              aria-expanded="false"
            >
              Services
            </a>
            <div id="mobile-services-menu" class="collapse ps-4">
              <ul class="navbar-nav ms-auto mt-0">
                <li class="nav-item"><a href="/hire/resources/" class="nav-link text-start">Hire Software Developers</a></li>
                <li class="nav-item"><a href="/technologies/spree/" class="nav-link">Build E-commerce Apps</a></li>
                <li class="nav-item"><a href="/technologies/gatsby-js/" class="nav-link">Build Static Site</a></li>
                <li class="nav-item"><a href="/technologies/react-js/" class="nav-link">React Js</a></li>
                <li class="nav-item"><a href="/technologies/ruby-on-rails/" class="nav-link">Ruby on Rails</a></li>
                <li class="nav-item"><a href="/services/design/" class="nav-link">UI/UX Design services</a></li>
                <li class="nav-item"><a href="/services/digital-marketing/" class="nav-link">Digital Marketers</a></li>
                <li class="nav-item"><a href="/services/maintenance/tests/" class="nav-link">Maintain Write Tests</a></li>
                <li class="nav-item"><a href="/technologies/upgrade-your-application/" class="nav-link">Maintain Upgrade Application</a></li>
              </ul>
            </div>
          </li>
