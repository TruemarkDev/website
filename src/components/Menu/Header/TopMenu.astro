---
import BlogMegaMenu from '../../../theme/components/BlogMegaMenu/BlogMegaMenu';

interface Props {
  siteTitle?: string;
  blogPosts?: unknown[];
  blogCategories?: unknown[];
}

const { blogPosts = [], blogCategories = [] } = Astro.props;
