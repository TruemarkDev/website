<script>
  function initMobileNav() {
    const toggler = document.getElementById('mobile-toggler');
    const mobileNav = document.getElementById('mobile-nav');
    const navContent = document.getElementById('mobileNavContent');
    const logo = document.getElementById('mobile-logo');
    const servicesToggle = document.getElementById('mobile-services-toggle');
    const servicesMenu = document.getElementById('mobile-services-menu');

    if (!toggler || !mobileNav || !navContent) return;

    let isOpen = false;

    toggler.addEventListener('click', () => {
      isOpen = !isOpen;
      toggler.setAttribute('aria-expanded', String(isOpen));
      mobileNav.classList.toggle('mobile-nav-bg', isOpen);
      navContent.classList.toggle('show', isOpen);
      if (logo) {
        logo.src = isOpen
          ? '/images/company-logo/logo_white.svg'
          : '/images/company-logo/logo_red.svg';
      }
    });

    if (servicesToggle && servicesMenu) {
      let servicesOpen = false;
      servicesToggle.addEventListener('click', (e) => {
        e.preventDefault();
        servicesOpen = !servicesOpen;
        servicesToggle.setAttribute('aria-expanded', String(servicesOpen));
        servicesMenu.classList.toggle('show', servicesOpen);
      });
    }

    // Close mobile nav when a link is clicked
    navContent.querySelectorAll('a[href]:not(#mobile-services-toggle)').forEach((link) => {
      link.addEventListener('click', () => {
        isOpen = false;
        toggler.setAttribute('aria-expanded', 'false');
        mobileNav.classList.remove('mobile-nav-bg');
        navContent.classList.remove('show');
        if (logo) logo.src = '/images/company-logo/logo_red.svg';
      });
    });
  }

  initMobileNav();
  document.addEventListener('astro:after-swap', initMobileNav);
</script>
