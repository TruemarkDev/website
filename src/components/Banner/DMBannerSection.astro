---
import { faFileAlt, faChartBar } from '@fortawesome/free-solid-svg-icons';
import { faSearchengin } from '@fortawesome/free-brands-svg-icons';
import MoreTrafficImage from 'images/ecommerce/More-Traffic-image.png?url';

const fa = (icon: typeof faFileAlt) => {
  const [w, h, , , d] = icon.icon;
  return { w, h, d: Array.isArray(d) ? d.join('') : d };
};
const items = [
  { icon: fa(faSearchengin), title: 'SEO Strategy', text: 'Optimize your website for better visibility and branding.' },
  { icon: fa(faFileAlt), title: 'Content Strategy', text: 'Represent your business as a brand through valuable content.' },
  { icon: fa(faChartBar), title: 'Social Media Strategy', text: 'Reach your customers with right message.' },
];
---

<section>
  <div class="container">
    <div class="row flip-content-sm align-items-md-center">
      <div class="col-lg-6 col-md-12 col-sm-12 text-lg-start text-md-center text-center">
        <h2 class="mt-3 mb-2">Get more traffic to your website</h2>
        <p class="text-secondary mt-2">
          Increase your conversion rate and boost your ROI. We focus on:
        </p>

        <div class="d-flex flex-column flex-md-row flex-lg-column mt-lg-4 mt-5 ps-lg-1 ps-0">
          {items.map(({ icon, title, text }) => (
            <div class="media d-flex">
              <div class="icon-holder  d-flex justify-content-center align-items-center primary">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${icon.w} ${icon.h}`} width="1em" height="1em" fill="currentColor" aria-hidden="true">
                  <path d={icon.d} />
                </svg>
              </div>
              <div class="media-body">
                <h4 class="mb-lg-1 mb-2">{title}</h4>
                <p class="text-secondary mb-0">{text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="col-md-6">
        <img
          src={MoreTrafficImage}
          alt="Celebrate success"
          class="img-fluid flip-img"
        />
      </div>
    </div>
  </div>
</section>
