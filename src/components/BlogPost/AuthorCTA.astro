---
interface Props {
  name: string;
  position?: string;
  bio?: string;
  avatar?: string;
}

const { name, position, bio, avatar } = Astro.props;
const firstName = (name ?? '').split(' ')[0];
---

<aside class="post-cta-card author-cta-card my-4">
  <div class="post-cta-card__inner">
    <div class="post-cta-card__media">
      {avatar && (
        <img
          src={avatar}
          alt={name}
          class="post-cta-card__avatar"
          width="96"
          height="96"
          loading="lazy"
        />
      )}
    </div>
    <div class="post-cta-card__body">
      <div class="post-cta-card__heading-row">
        <div>
          <h4 class="post-cta-card__title">{name}</h4>
          {position && <p class="post-cta-card__subtitle">{position}</p>}
        </div>
        <a href="/contact/" class="btn btn-primary outlined post-cta-card__action">
          Hire {firstName}
        </a>
      </div>
      {bio && <p class="post-cta-card__text mb-0">{bio}</p>}
    </div>
  </div>
</aside>
