---
import { faPaperPlane, faEnvelopeOpenText } from '@fortawesome/free-solid-svg-icons';

interface Props {
  title?: string;
  text?: string;
  buttonText?: string;
}

const {
  title = 'Stay in the loop',
  text = 'Insights, case studies, and team stories from Truemark — straight to your inbox.',
  buttonText = 'Subscribe',
} = Astro.props;

const endpoint = import.meta.env.PUBLIC_SUBSCRIBE_ENDPOINT ?? '';
const formId = `subscribe-${Math.random().toString(36).slice(2, 9)}`;

const fa = (icon: typeof faPaperPlane) => {
  const [w, h, , , pathData] = icon.icon;
  return { w, h, d: Array.isArray(pathData) ? pathData.join('') : pathData };
};
const sendIcon = fa(faPaperPlane);
const mailIcon = fa(faEnvelopeOpenText);
---

<aside class="post-cta-card subscribe-card my-4" aria-labelledby={`${formId}-title`}>
  <div class="post-cta-card__inner">
    <div class="post-cta-card__media">
      <div class="subscribe-card__icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="36"
          viewBox={`0 0 ${mailIcon.w} ${mailIcon.h}`}
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={mailIcon.d} />
        </svg>
      </div>
    </div>
    <div class="post-cta-card__body">
      <div class="post-cta-card__heading-row">
        <div>
          <h4 id={`${formId}-title`} class="post-cta-card__title">{title}</h4>
          <p class="post-cta-card__subtitle">{text}</p>
        </div>
      </div>
      <form
        id={formId}
        class="subscribe-form"
        data-endpoint={endpoint}
        novalidate
      >
        <div class="subscribe-form__row">
          <input
            type="email"
            name="email"
            class="form-control subscribe-form__input"
            placeholder="you@example.com"
            aria-label="Email address"
            autocomplete="email"
            required
          />
          <button type="submit" class="btn btn-primary subscribe-form__btn">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox={`0 0 ${sendIcon.w} ${sendIcon.h}`}
              fill="currentColor"
              aria-hidden="true"
              class="me-2"
              style="vertical-align: -2px;"
            >
              <path d={sendIcon.d} />
            </svg>
            {buttonText}
          </button>
        </div>
        <p class="subscribe-form__feedback mt-2 mb-0" role="status" aria-live="polite"></p>
        <p class="subscribe-form__privacy mt-1 mb-0">
          No spam. Unsubscribe at any time.
        </p>
      </form>
    </div>
  </div>
</aside>

<script>
  document.querySelectorAll<HTMLFormElement>('form.subscribe-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[name="email"]');
      const feedback = form.querySelector<HTMLElement>('.subscribe-form__feedback');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!input || !feedback || !button) return;

      const email = input.value.trim();
      const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (!ok) {
        feedback.textContent = 'Please enter a valid email address.';
        return;
      }

      const endpoint = form.dataset.endpoint;
      button.disabled = true;
      button.dataset.originalText ??= button.textContent ?? '';
      button.textContent = 'Subscribing…';

      try {
        if (endpoint) {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contact: { email } }),
          });
          if (!res.ok) throw new Error(String(res.status));
          feedback.textContent = 'Thanks — check your inbox to confirm.';
          form.reset();
        } else {
          window.location.href = `mailto:hello@truemark.com.np?subject=Subscribe&body=Please add ${encodeURIComponent(email)} to your newsletter list.`;
          feedback.textContent = 'Opening your email client…';
        }
      } catch (_) {
        feedback.textContent = 'Something went wrong. Please try again later.';
      } finally {
        button.disabled = false;
        button.textContent = button.dataset.originalText ?? 'Subscribe';
      }
    });
  });
</script>

<style is:global>
  /* Shared visual language for AuthorCTA + SubscribeBanner — keeps them as a
     cohesive pair sitting under the article. Quiet, content-aligned, subtle
     shadow + a left red accent bar. */
  .post-cta-card {
    background-color: #ffffff;
    border-radius: 0.75rem;
    border-left: 4px solid var(--primary-color, #ff5757);
    box-shadow: 0 0.25rem 1.25rem rgba(0, 0, 0, 0.06);
    padding: 1.5rem 1.5rem;
    transition: box-shadow 0.2s ease;
  }

  .post-cta-card:hover {
    box-shadow: 0 0.4rem 1.5rem rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 768px) {
    .post-cta-card {
      padding: 1.75rem 2rem;
    }
  }

  .post-cta-card__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  @media (min-width: 576px) {
    .post-cta-card__inner {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      gap: 1.5rem;
    }
  }

  .post-cta-card__media {
    flex-shrink: 0;
  }

  .post-cta-card__avatar {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
  }

  .post-cta-card__body {
    flex: 1;
    min-width: 0;
  }

  .post-cta-card__heading-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 576px) {
    .post-cta-card__heading-row {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }

  .post-cta-card__title {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.15rem;
    line-height: 1.3;
  }

  .post-cta-card__subtitle {
    font-size: 0.9rem;
    color: var(--text-secondary, #6b7280);
    margin: 0;
    line-height: 1.5;
  }

  .post-cta-card__text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-primary, #1c2031);
  }

  .post-cta-card__action {
    flex-shrink: 0;
    align-self: center;
  }

  @media (min-width: 576px) {
    .post-cta-card__action {
      align-self: flex-start;
    }
  }

  /* SubscribeBanner specifics */
  .subscribe-card__icon {
    width: 4rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 87, 87, 0.1);
    color: var(--primary-color, #ff5757);
  }

  .subscribe-form__row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  @media (min-width: 480px) {
    .subscribe-form__row {
      flex-direction: row;
      align-items: stretch;
      gap: 0.5rem;
    }
  }

  .subscribe-form__input.form-control {
    flex: 1;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.12);
    color: #1c2031;
    font-size: 0.92rem;
    padding: 0.55rem 0.85rem;
    border-radius: 0.4rem;
  }

  .subscribe-form__input.form-control:focus {
    border-color: var(--primary-color, #ff5757);
    box-shadow: 0 0 0 0.18rem rgba(255, 87, 87, 0.18);
  }

  .subscribe-form__btn.btn {
    border-radius: 0.4rem;
    padding: 0.55rem 1.1rem;
    font-weight: 500;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .subscribe-form__feedback {
    font-size: 0.82rem;
    min-height: 1em;
    color: var(--primary-color, #ff5757);
  }

  .subscribe-form__privacy {
    font-size: 0.75rem;
    color: var(--text-secondary, #6b7280);
    opacity: 0.85;
  }
</style>
