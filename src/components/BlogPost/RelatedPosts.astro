---
import { Picture } from 'astro:assets';
import { resolveImage } from '../../lib/image-resolver';
import fallbackImage from '../../assets/images/startup.jpg';

interface RelatedPost {
  slug: string;
  title: string;
  hero?: string | null;
  category?: string;
}

interface Props {
  posts: RelatedPost[];
  title?: string;
}

const { posts, title = 'Related Posts' } = Astro.props;

const resolved = await Promise.all(
  posts.map(async (post) => ({
    ...post,
    heroImage: (await resolveImage(post.hero)) ?? fallbackImage,
  }))
);
---

{posts.length > 0 && (
  <aside id="blog" class="related-posts-section pb-0 pt-0">
    <div class="px-0 text-start">
      <h3>{title}</h3>
    </div>
    <ul class="list-unstyled ps-0">
      {resolved.map((post) => (
        <li class="mb-4">
          <div class="blog-post d-flex flex-column">
            <figure class="card_image position-relative mb-3">
              <a href={`/blog/${post.slug}/`} title={post.title} rel="bookmark">
                <Picture
                  src={post.heroImage}
                  formats={['avif', 'webp']}
                  alt={post.title}
                  class="card-img-top mb-0 w-100"
                  loading="lazy"
                  decoding="async"
                  widths={[200, 400, 600]}
                  sizes="(max-width: 768px) 100vw, 33vw"
                  quality={65}
                />
              </a>
              {post.category && (
                <span class="wpb-category">
                  <a href={`/blog/${post.slug}/`}>{post.category}</a>
                </span>
              )}
            </figure>
            <h4 class="card-title">
              <a href={`/blog/${post.slug}/`} title={post.title} rel="bookmark">
                {post.title}
              </a>
            </h4>
          </div>
        </li>
      ))}
    </ul>
  </aside>
)}
